# macOS
.DS_Store

# build output
dist/
# ...except the rendered skill pack, which is committed and checked for drift.
# tsc still writes dist/src and dist/test there, which stay ignored.
!packages/skills/dist/
packages/skills/dist/src/
packages/skills/dist/test/
docs/_site/
*.tsbuildinfo

# dependencies
node_modules/

# yarn 4 (corepack; no committed release binary)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/versions
.pnp.*

# test / coverage
coverage/
.nyc_output/

# local config that must never be committed
.aat.json
*.local

# scratch files for local experiments; never committed (decided 2026-09-17)
.scratch/
