{
  "name": "@dcfoundation/aat-schemas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The shared aat formats: JSON Schema, TypeScript types, validators and fixtures.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "schemas",
    "fixtures"
  ],
  "engines": {
    "node": "^22.11 || ^24.14"
  },
  "devDependencies": {
    "@endo/init": "1.1.12",
    "@endo/ses-ava": "1.3.2",
    "ava": "6.4.1"
  },
  "scripts": {
    "test": "ava"
  },
  "ava": {
    "files": [
      "test/**/*.test.ts"
    ],
    "require": [
      "@endo/init/debug.js"
    ],
    "typescript": {
      "rewritePaths": {
        "src/": "dist/src/",
        "test/": "dist/test/"
      },
      "compile": false
    },
    "timeout": "2m"
  }
}
