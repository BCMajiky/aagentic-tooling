@@ -0,0 +1,42 @@
+/**
+ * Guest flow: calls to orchestration accounts and Zoe tools are translated
+ * through the async-flow membrane, so awaiting a Vow waits for settlement.
+ */
+export const fundOsmosis = async (orch, { zoeTools }, seat) => {
+  const { give } = seat.getProposal();
+  const { Funds: amount } = give;
+
+  let localAccount;
+  let deposited = false;
+  try {
+    const agoric = await orch.getChain('agoric');
+    const assets = await agoric.getVBankAssetInfo();
+    const asset = assets.find(({ brand }) => brand === amount.brand);
+    assert(asset, 'Offered brand is not registered in vbank');
+
+    const osmosis = await orch.getChain('osmosis');
+    const destination = await osmosis.makeAccount();
+    const address = await destination.getAddress();
+    // Use a separate staging account for each offer.
+    localAccount = await agoric.makeAccount();
+
+    // localTransfer restores the seat itself if depositing fails.
+    await zoeTools.localTransfer(seat, localAccount, give);
+    deposited = true;
+    await localAccount.transfer(address, {
+      denom: asset.denom,
+      value: amount.value,
+    });
+    seat.exit();
+    // Return control of the funded account to the offerer.
+    return destination;
+  } catch (error) {
+    // Do not exit/fail the seat before the refund has been reallocated to it.
+    if (deposited) {
+      await zoeTools.withdrawToSeat(localAccount, seat, give);
+    }
+    seat.fail(error);
+    throw error;
+  }
+};
+harden(fundOsmosis);
diff --git a/test/osmosis.test.js b/test/osmosis.test.js
new file mode 100644
index 0000000..b3ba84c
--- /dev/null
+++ b/test/osmosis.test.js
@@ -0,0 +1,164 @@
+import test from 'ava';
+import bundleSource from '@endo/bundle-source';
+import { fileURLToPath } from 'node:url';
+import * as productionContract from '../src/osmosis.contract.js';
+import { E, Far } from '@endo/far';
+import { makePromiseKit } from '@endo/promise-kit';
+import { AmountMath, makeIssuerKit } from '@agoric/ertp';
+import { makeHeapZone } from '@agoric/zone';
+import { prepareVowTools } from '@agoric/vow';
+import { setUpZoeForTest } from '@agoric/zoe/tools/setup-zoe.js';
+import { eventLoopIteration } from '@agoric/internal/src/testing-utils.js';
+import * as testContract from './support/contract.js';
+
+const setup = async (t, { failCreation = false, failDeposit = false, unknownBrand = false, delayRefund = false } = {}) => {
+  const { zoe, bundleAndInstall } = await setUpZoeForTest();
+  const installation = await bundleAndInstall(testContract);
+  const { issuer, mint, brand } = makeIssuerKit('Funds');
+  const amount = AmountMath.make(brand, 123n);
+  const localPurse = issuer.makeEmptyPurse();
+  const remotePurse = issuer.makeEmptyPurse();
+  const transfer = makePromiseKit();
+  const started = makePromiseKit();
+  const refundStarted = makePromiseKit();
+  const refundGate = makePromiseKit();
+  const { asVow, when } = prepareVowTools(makeHeapZone());
+  const address = harden({ chainId: 'osmosis-1', encoding: 'bech32', value: 'osmo1test' });
+  let created = 0;
+  const destination = Far('Osmosis account', { getAddress: () => address });
+  const localAccount = Far('Local account', {
+    deposit: payment => {
+      if (failDeposit) throw Error('deposit failed');
+      return localPurse.deposit(payment);
+    },
+    withdraw: async amt => {
+      refundStarted.resolve();
+      if (delayRefund) await refundGate.promise;
+      return localPurse.withdraw(amt);
+    },
+    transfer: (to, amt) => asVow(async () => {
+      t.deepEqual(to, address);
+      t.deepEqual(amt, { denom: 'ufunds', value: 123n });
+      started.resolve();
+      await transfer.promise;
+      remotePurse.deposit(localPurse.withdraw(amount));
+    }),
+  });
+  const agoric = Far('Agoric chain', {
+    getVBankAssetInfo: () => asVow(() => unknownBrand ? [] : harden([{ brand, denom: 'ufunds' }])),
+    makeAccount: () => asVow(() => localAccount),
+  });
+  const osmosis = Far('Osmosis chain', {
+    makeAccount: () => asVow(() => {
+      created += 1;
+      if (failCreation) throw Error('account creation failed');
+      return destination;
+    }),
+  });
+  const orch = Far('Orchestrator', {
+    getChain: name => {
+      t.true(['agoric', 'osmosis'].includes(name));
+      return asVow(() => name === 'agoric' ? agoric : osmosis);
+    },
+  });
+  const { publicFacet } = await E(zoe).startInstance(installation, { Funds: issuer }, {}, {
+    orch, timerService: Far('timer', {}), orchestrationService: Far('service', {}),
+  });
+  const offer = async (proposal = harden({ give: { Funds: amount }, exit: { waived: null } })) => {
+    const invitation = await E(publicFacet).makeOsmosisInvitation();
+    return E(zoe).offer(invitation, proposal, { Funds: mint.mintPayment(amount) });
+  };
+  return { offer, when, amount, issuer, publicFacet, transfer, started,
+    localPurse, remotePurse, address, refundStarted, refundGate, created: () => created };
+};
+
+const payoutAmount = async (s, seat) => E(s.issuer).getAmountOf(await E(seat).getPayout('Funds'));
+
+test('funds the new Osmosis account only after transfer acknowledgement', async t => {
+  const s = await setup(t);
+  const seat = await s.offer();
+  const result = s.when(await E(seat).getOfferResult());
+  await s.started.promise;
+  t.false(await E(seat).hasExited());
+  t.deepEqual(s.localPurse.getCurrentAmount(), s.amount);
+  await t.throwsAsync(E(seat).tryExit(), { message: /onDemand/ });
+  s.transfer.resolve();
+  const account = await result;
+  t.deepEqual(await s.when(E(account).getAddress()), s.address);
+  t.is(s.created(), 1);
+  t.deepEqual(s.remotePurse.getCurrentAmount(), s.amount);
+  t.is((await payoutAmount(s, seat)).value, 0n);
+  t.is(s.localPurse.getCurrentAmount().value, 0n);
+});
+
+for (const reason of ['IBC acknowledgement error', 'IBC timeout']) {
+  test(`refunds the full ERTP payment on ${reason}`, async t => {
+    const s = await setup(t);
+    const seat = await s.offer();
+    const rejected = t.throwsAsync(s.when(await E(seat).getOfferResult()), { message: reason });
+    await s.started.promise;
+    t.false(await E(seat).hasExited());
+    s.transfer.reject(Error(reason));
+    await rejected;
+    t.deepEqual(await payoutAmount(s, seat), s.amount);
+    t.is(s.localPurse.getCurrentAmount().value, 0n);
+    t.is(s.remotePurse.getCurrentAmount().value, 0n);
+  });
+}
+
+for (const [option, message] of [
+  ['failCreation', 'account creation failed'],
+  ['failDeposit', /One or more deposits failed/],
+  ['unknownBrand', 'Offered brand is not registered in vbank'],
+]) {
+  test(`refunds when ${option}`, async t => {
+    const s = await setup(t, { [option]: true });
+    const seat = await s.offer();
+    await t.throwsAsync(s.when(await E(seat).getOfferResult()), { message });
+    await eventLoopIteration();
+    t.true(await E(seat).hasExited());
+    t.deepEqual(await payoutAmount(s, seat), s.amount);
+    t.is(s.localPurse.getCurrentAmount().value, 0n);
+  });
+}
+
+test('rejects an on-demand exit proposal before moving funds', async t => {
+  const s = await setup(t);
+  await t.throwsAsync(s.offer(harden({ give: { Funds: s.amount } })), { message: /waived|exit|onDemand/ });
+  t.is(s.created(), 0);
+});
+
+
+test('keeps the seat open until the refund reaches Zoe', async t => {
+  const s = await setup(t, { delayRefund: true });
+  const seat = await s.offer();
+  const rejected = t.throwsAsync(s.when(await E(seat).getOfferResult()), { message: 'transfer rejected' });
+  await s.started.promise;
+  s.transfer.reject(Error('transfer rejected'));
+  await s.refundStarted.promise;
+  t.false(await E(seat).hasExited());
+  t.deepEqual(s.localPurse.getCurrentAmount(), s.amount);
+  s.refundGate.resolve();
+  await rejected;
+  t.deepEqual(await payoutAmount(s, seat), s.amount);
+});
+
+test('production start creates its single invitation using withOrchestration', async t => {
+  const { zoe, bundleAndInstall } = await setUpZoeForTest();
+  const installation = await bundleAndInstall(productionContract);
+  const { publicFacet } = await E(zoe).startInstance(installation, {}, {}, {
+    agoricNames: Far('names', {}),
+    localchain: Far('localchain', {}),
+    orchestrationService: Far('service', {}),
+    timerService: Far('timer', {}),
+    marshaller: Far('marshaller', {}),
+  });
+  const invitation = await E(publicFacet).makeOsmosisInvitation();
+  const details = await E(zoe).getInvitationDetails(invitation);
+  t.is(details.description, 'fund Osmosis account');
+});
+
+test('production contract bundles with the pinned dependencies', async t => {
+  const bundle = await bundleSource(fileURLToPath(new URL('../src/osmosis.contract.js', import.meta.url)));
+  t.is(bundle.moduleFormat, 'endoZipBase64');
+});
