+import { M } from '@endo/patterns';
+import { InvitationShape } from '@agoric/zoe/src/typeGuards.js';
+import { AnyNatAmountShape } from '@agoric/orchestration/src/typeGuards.js';
+import { withOrchestration } from '@agoric/orchestration/src/utils/start-helper.js';
+import { registerChainsAndAssets } from '@agoric/orchestration/src/utils/chain-hub-helper.js';
+import { fundOsmosis } from './osmosis.flows.js';
+
+export const contract = async (zcf, privateArgs, zone, tools) => {
+  const { orchestrate, chainHub, zoeTools } = tools;
+  registerChainsAndAssets(
+    chainHub,
+    zcf.getTerms().brands,
+    privateArgs.chainInfo,
+    privateArgs.assetInfo,
+  );
+  const handler = orchestrate('fundOsmosis', { zoeTools }, fundOsmosis);
+  const publicFacet = zone.exo(
+    'Osmosis public facet',
+    M.interface('Osmosis public facet', {
+      makeOsmosisInvitation: M.callWhen().returns(InvitationShape),
+    }),
+    {
+      makeOsmosisInvitation() {
+        return zcf.makeInvitation(handler, 'fund Osmosis account', undefined, {
+          give: { Funds: AnyNatAmountShape },
+          want: {},
+          // Prevent the offerer from exiting while funds are outside Zoe.
+          exit: { waived: null },
+        });
+      },
+    },
+  );
+  return harden({ publicFacet });
+};
+harden(contract);
+
+export const start = withOrchestration(contract);
+harden(start);
diff --git a/src/osmosis.flows.js b/src/osmosis.flows.js
