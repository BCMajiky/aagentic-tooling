@@ -0,0 +1,41 @@
+import { E, Far } from '@endo/far';
+import { makeHeapZone } from '@agoric/zone';
+import { prepareVowTools } from '@agoric/vow';
+import { prepareAsyncFlowTools } from '@agoric/async-flow';
+import { makeOrchestrationFacade } from '@agoric/orchestration/src/facade.js';
+import { makeZoeTools } from '@agoric/orchestration/src/utils/zoe-tools.js';
+import { contract } from '../../src/osmosis.contract.js';
+
+// Real Zoe, transfer helpers, and async-flow membrane; only chains are faked.
+export const start = async (zcf, { orch, timerService, orchestrationService }) => {
+  const zone = makeHeapZone();
+  const vowTools = prepareVowTools(zone.subZone('vows'));
+  const asyncFlowTools = prepareAsyncFlowTools(zone.subZone('flows'), { vowTools });
+  const { asVow, when } = vowTools;
+  const accountAdapter = (remote, local) => Far('Account adapter', {
+    getAddress: () => asVow(() => E(remote).getAddress()),
+    ...(local ? {
+      deposit: payment => asVow(() => E(remote).deposit(payment)),
+      withdraw: amount => asVow(() => E(remote).withdraw(amount)),
+      transfer: (address, amount) => asVow(() => when(E(remote).transfer(address, amount))),
+    } : {}),
+  });
+  const hostOrch = Far('Host orchestrator', {
+    getChain: name => asVow(async () => {
+      const chain = await when(E(orch).getChain(name));
+      return Far('Chain adapter', {
+        getVBankAssetInfo: () => asVow(() => when(E(chain).getVBankAssetInfo())),
+        makeAccount: () => asVow(async () => accountAdapter(
+          await when(E(chain).makeAccount()), name === 'agoric',
+        )),
+      });
+    }),
+  });
+  const { orchestrate } = makeOrchestrationFacade({
+    zone: zone.subZone('facade'), zcf, timerService, orchestrationService,
+    makeOrchestrator: () => hostOrch, vowTools, asyncFlowTools,
+  });
+  return contract(zcf, {}, zone.subZone('contract'), {
+    orchestrate, zoeTools: makeZoeTools(zcf, vowTools),
+  });
+};
