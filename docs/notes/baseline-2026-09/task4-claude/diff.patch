+/**
+ * @file Orchestration test environment, a trimmed JS port of
+ *   `@agoric/orchestration/tools/contract-tests.ts` (see network-fakes.js for
+ *   why it is ported).
+ */
+import { makeIssuerKit } from '@agoric/ertp';
+import { VTRANSFER_IBC_EVENT } from '@agoric/internal/src/action-types.js';
+import { makeFakeStorageKit } from '@agoric/internal/src/storage-test-utils.js';
+import { eventLoopIteration } from '@agoric/internal/src/testing-utils.js';
+import { withChainCapabilities } from '@agoric/orchestration';
+import { registerKnownChains } from '@agoric/orchestration/src/chain-info.js';
+import { prepareCosmosInterchainService } from '@agoric/orchestration/src/exos/cosmos-interchain-service.js';
+import fetchedChainInfo from '@agoric/orchestration/src/fetched-chain-info.js';
+import { makeTestAddress } from '@agoric/orchestration/tools/make-test-address.js';
+import { makeNameHubKit } from '@agoric/vats';
+import { prepareBridgeTargetModule } from '@agoric/vats/src/bridge-target.js';
+import { prepareLocalChainTools } from '@agoric/vats/src/localchain.js';
+import { prepareTransferTools } from '@agoric/vats/src/transfer.js';
+import { makeFakeBankManagerKit } from '@agoric/vats/tools/bank-utils.js';
+import { makeFakeBoard } from '@agoric/vats/tools/board-utils.js';
+import {
+  makeFakeLocalchainBridge,
+  makeFakeTransferBridge,
+} from '@agoric/vats/tools/fake-bridge.js';
+import { prepareSwingsetVowTools } from '@agoric/vow/vat.js';
+import { buildZoeManualTimer } from '@agoric/zoe/tools/manualTimer.js';
+import { makeHeapZone } from '@agoric/zone';
+import { E } from '@endo/far';
+import { setupFakeNetwork } from './network-fakes.js';
+
+export const ROOT_STORAGE_PATH = 'orchtest';
+
+/** @param {(...args: unknown[]) => void} log */
+export const setupOrchestrationTest = async log => {
+  const rootZone = makeHeapZone();
+  const vowTools = prepareSwingsetVowTools(rootZone.subZone('vows'));
+
+  const { nameHub: agoricNames, nameAdmin: agoricNamesAdmin } =
+    makeNameHubKit();
+
+  const { bankManager, pourPayment } = await makeFakeBankManagerKit();
+  const ist = makeIssuerKit('IST');
+  await E(bankManager).addAsset('uist', 'IST', 'Inter Stable Token', ist);
+
+  // vtransfer bridge, so tests can inject IBC acks for outgoing transfers
+  const transferBridge = makeFakeTransferBridge(rootZone);
+  const { makeBridgeTargetKit } = prepareBridgeTargetModule(
+    rootZone.subZone('bridge'),
+  );
+  const { makeTransferMiddlewareKit } = prepareTransferTools(
+    rootZone.subZone('transfer'),
+    vowTools,
+  );
+  const { finisher, interceptorFactory, transferMiddleware } =
+    makeTransferMiddlewareKit();
+  const bridgeTargetKit = makeBridgeTargetKit(
+    transferBridge,
+    VTRANSFER_IBC_EVENT,
+    interceptorFactory,
+  );
+  finisher.useRegistry(bridgeTargetKit.targetRegistry);
+  await E(transferBridge).initHandler(bridgeTargetKit.bridgeHandler);
+
+  /** @type {{ obj: any; result: any }[]} */
+  const localBridgeLog = [];
+  const localchainBridge = makeFakeLocalchainBridge(
+    rootZone,
+    (obj, result) => localBridgeLog.push({ obj, result }),
+    makeTestAddress,
+  );
+  const powersForTransfer = rootZone.weakMapStore('powersForTransfer');
+  const localchain = prepareLocalChainTools(rootZone.subZone('localchain'), {
+    ...vowTools,
+    powersForTransfer,
+  })({ bankManager, system: localchainBridge, transfer: transferMiddleware });
+  powersForTransfer.init(
+    transferMiddleware,
+    harden({ transferBridgeManager: transferBridge }),
+  );
+
+  const { portAllocator, ibcBridge } = await setupFakeNetwork(
+    rootZone.subZone('network'),
+    { vowTools },
+  );
+  const cosmosInterchainService = prepareCosmosInterchainService(
+    rootZone.subZone('orchestration'),
+    vowTools,
+  )({ portAllocator });
+
+  await registerKnownChains(agoricNamesAdmin, () => {});
+
+  const storage = makeFakeStorageKit(ROOT_STORAGE_PATH, { sequence: true });
+  const timer = buildZoeManualTimer(log);
+  const marshaller = makeFakeBoard().getPublishingMarshaller();
+
+  /** Outgoing MsgTransfers sent through the localchain bridge */
+  const outgoingTransfers = () =>
+    localBridgeLog.flatMap(({ obj, result }) =>
+      obj.type === 'VLOCALCHAIN_EXECUTE_TX' && Array.isArray(result)
+        ? obj.messages.flatMap((message, i) =>
+            message['@type'] === '/ibc.applications.transfer.v1.MsgTransfer'
+              ? [{ message, sequence: BigInt(result[i].sequence) }]
+              : [],
+          )
+        : [],
+    );
+
+  /**
+   * Simulate the IBC outcome of an outgoing transfer.
+   *
+   * @param {'acknowledgementPacket' | 'timeoutPacket'} event
+   * @param {number} index into outgoingTransfers(); negative counts from end
+   * @param {string} [acknowledgementError]
+   */
+  const transmitVTransferEvent = async (
+    event,
+    index,
+    acknowledgementError,
+  ) => {
+    await eventLoopIteration();
+    const found = outgoingTransfers().at(index);
+    if (!found) throw Error(`no outgoing transfer at index ${index}`);
+    const { message: msg, sequence } = found;
+    const packet = {
+      data: btoa(
+        JSON.stringify({
+          amount: msg.token.amount,
+          denom: msg.token.denom,
+          sender: msg.sender,
+          receiver: msg.receiver,
+          memo: msg.memo,
+        }),
+      ),
+      destination_channel: 'channel-0',
+      source_channel: msg.sourceChannel,
+      destination_port: 'transfer',
+      source_port: 'transfer',
+      sequence,
+    };
+    const base = {
+      type: VTRANSFER_IBC_EVENT,
+      blockHeight: 0,
+      blockTime: 0,
+      event,
+      target: msg.sender,
+      packet,
+    };
+    await E(transferBridge).fromBridge(
+      event === 'timeoutPacket'
+        ? base
+        : {
+            ...base,
+            relayer: 'agoric123',
+            acknowledgement: btoa(
+              JSON.stringify(
+                acknowledgementError
+                  ? { error: acknowledgementError }
+                  : { result: 'AQ==' },
+              ),
+            ),
+          },
+    );
+    await eventLoopIteration();
+  };
+
+  const { agoric, osmosis } = withChainCapabilities(fetchedChainInfo);
+
+  return {
+    ist,
+    bankManager,
+    ibcBridge,
+    storage,
+    commonPrivateArgs: {
+      agoricNames,
+      localchain,
+      orchestrationService: cosmosInterchainService,
+      storageNode: storage.rootNode,
+      marshaller,
+      timerService: timer,
+      chainInfo: harden({ agoric, osmosis }),
+      assetInfo: harden([
+        [
+          'uist',
+          {
+            baseDenom: 'uist',
+            baseName: 'agoric',
+            chainName: 'agoric',
+            brandKey: 'IST',
+          },
+        ],
+      ]),
+    },
+    utils: { pourPayment, outgoingTransfers, transmitVTransferEvent },
+  };
+};
